{% extends 'base.html.twig' %}

{% block title %}Edit secret message #{{ secret_message.id }}{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('secret_message_index') }}" class="btn btn-outline-secondary">← Back to list</a>
</div>
<div class="card shadow-sm">
    <div class="card-header">
        <h2 class="mb-0">Edit secret message #{{ secret_message.id }}</h2>
    </div>
    <div class="card-body">
        {{ form_start(form, { attr: { class: 'needs-validation', novalidate: true } }) }}
        {{ form_widget(form) }}
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Update</button>
            <a href="{{ path('secret_message_show', { id: secret_message.id }) }}" class="btn btn-secondary">Cancel</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
