{% extends 'base.html.twig' %}

{% block title %}Sensitive records (raw SQL){% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <h2 class="mb-0">Sensitive records – Raw SQL</h2>
        <a href="{{ path('sensitive_record_index') }}" class="btn btn-outline-light btn-sm">Doctrine (decrypted)</a>
    </div>
    <div class="card-body">
        <p class="text-muted small">Ciphertext as stored in DB.</p>
        {% if rows|length > 0 %}
            <table class="table table-hover">
                <thead class="table-light"><tr><th>Id</th><th>Personal note (raw)</th><th>Financial note (raw)</th><th>Actions</th></tr></thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.id }}</td>
                            <td><code class="small">{{ row.personal_note ? (row.personal_note|slice(0, 50)) ~ '…' : '–' }}</code></td>
                            <td><code class="small">{{ row.financial_note ? (row.financial_note|slice(0, 50)) ~ '…' : '–' }}</code></td>
                            <td>
                                <a href="{{ path('sensitive_record_show', { id: row.id }) }}" class="btn btn-sm btn-outline-secondary">Show</a>
                                <a href="{{ path('sensitive_record_edit', { id: row.id }) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted mb-0">No rows.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
