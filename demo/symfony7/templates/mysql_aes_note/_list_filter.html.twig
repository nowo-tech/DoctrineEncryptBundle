{# @var filter array{title: string, secret: string, secret_mode: string} #}
<form method="get" class="row g-3 align-items-start mb-4 border rounded p-3 bg-body-tertiary">
    <div class="col-lg-3 col-md-6">
        <label class="form-label" for="filter_title">Title</label>
        <input type="text" name="title" id="filter_title" class="form-control" value="{{ filter.title }}"
               placeholder="e.g. invoice">
        <div class="form-text">Plain column · <code>LIKE '%…%'</code></div>
    </div>
    <div class="col-lg-3 col-md-6">
        <label class="form-label" for="filter_secret">Secret</label>
        <input type="text" name="secret" id="filter_secret" class="form-control" value="{{ filter.secret }}"
               placeholder="e.g. password">
    </div>
    <div class="col-lg-4 col-md-8">
        <label class="form-label" for="filter_secret_mode">Secret search mode</label>
        <select name="secret_mode" id="filter_secret_mode" class="form-select">
            {% for value, label in secretModeOptions %}
                <option value="{{ value }}"{% if filter.secret_mode == value %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-lg-2 col-md-4 d-grid gap-2 align-self-lg-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="{{ clearPath }}" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>
{% if queryDescription is defined and queryDescription %}
    <details class="mb-4">
        <summary class="text-muted small user-select-none">Query / strategy used</summary>
        <pre class="small bg-dark text-light p-3 rounded mb-0 mt-2"><code>{{ queryDescription }}</code></pre>
    </details>
{% endif %}
