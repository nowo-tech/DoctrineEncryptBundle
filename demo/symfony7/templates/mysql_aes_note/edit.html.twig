{% extends 'base.html.twig' %}

{% block title %}Edit MySQL AES note{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('mysql_aes_note_show', { id: note.id }) }}" class="btn btn-outline-secondary">← Back</a>
</div>
<div class="card shadow-sm">
    <div class="card-header">
        <h2 class="mb-0 h5">Edit note #{{ note.id }}</h2>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
        <div class="vstack gap-3">
            {{ form_row(form.title) }}
            {{ form_row(form.secretOrm) }}
        </div>
        {% include 'mysql_aes_note/_form_actions.html.twig' with {
            submit_label: 'Update',
            cancel_path: path('mysql_aes_note_show', { id: note.id }),
        } %}
        {{ form_end(form) }}

        <form method="post" action="{{ path('mysql_aes_note_delete', { id: note.id }) }}" class="mt-4 pt-3 border-top" onsubmit="return confirm('Delete this note?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>
{% endblock %}
