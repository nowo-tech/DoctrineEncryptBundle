{% extends 'base.html.twig' %}

{% block title %}MySQL AES notes{% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="h4 mb-0">MySQL AES notes</h1>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('mysql_aes_note_db_values') }}" class="btn btn-outline-secondary btn-sm">DB: raw vs decrypted</a>
            {% if nativeSupported %}
                <a href="{{ path('mysql_aes_note_sql_index') }}" class="btn btn-outline-secondary btn-sm">SQL list</a>
                <a href="{{ path('mysql_aes_note_sql_raw') }}" class="btn btn-outline-secondary btn-sm">Raw HEX</a>
                <a href="{{ path('mysql_aes_note_sql_new') }}" class="btn btn-outline-primary btn-sm">SQL insert</a>
            {% endif %}
            <a href="{{ path('mysql_aes_note_new') }}" class="btn btn-primary btn-sm">New (Doctrine)</a>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-light border small mb-4">
            <p class="mb-1"><strong>Doctrine path</strong> — <code>secret_orm</code> with <code>#[Encrypted('mysql_aes')]</code> (subscriber + <code>&lt;ENC&gt;</code> marker).</p>
            <p class="mb-0"><strong>Repository path</strong> — <code>secret_native</code> via <code>AES_ENCRYPT(:plain, :key)</code> in SQL (MySQL/MariaDB only).</p>
        </div>

        {% if not nativeSupported %}
            <div class="alert alert-warning mb-4">
                Native <code>AES_ENCRYPT</code> / <code>AES_DECRYPT</code> need MySQL.
                Uncomment the MySQL <code>DATABASE_URL</code> in <code>.env.example</code>, copy to <code>.env</code>, then restart the stack.
            </div>
        {% endif %}

        <h2 class="h6 text-muted text-uppercase mb-3">Filter (LIKE)</h2>

        {% include 'mysql_aes_note/_list_filter.html.twig' with {
            filter: filter,
            clearPath: path('mysql_aes_note_index'),
            secretModeOptions: {
                plaintext: 'After decrypt (PHP contains)',
                ciphertext: 'LIKE on secret_orm (ciphertext)',
            },
            queryDescription: queryDescription,
        } only %}

        {% if notes|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Title</th>
                            <th scope="col">Secret (ORM, decrypted)</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for note in notes %}
                            <tr>
                                <td>{{ note.id }}</td>
                                <td>{{ note.title }}</td>
                                <td class="text-break">{{ note.secretOrm ? note.secretOrm|slice(0, 40) ~ (note.secretOrm|length > 40 ? '…' : '') : '–' }}</td>
                                <td class="text-end text-nowrap">
                                    <a href="{{ path('mysql_aes_note_show', { id: note.id }) }}" class="btn btn-sm btn-outline-secondary">Show</a>
                                    <a href="{{ path('mysql_aes_note_edit', { id: note.id }) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-5 border rounded bg-body-tertiary">
                <p class="text-muted mb-3">No notes yet.</p>
                <a href="{{ path('mysql_aes_note_new') }}" class="btn btn-primary">Create first note (Doctrine)</a>
                {% if nativeSupported %}
                    <span class="text-muted mx-2">or</span>
                    <a href="{{ path('mysql_aes_note_sql_new') }}" class="btn btn-outline-primary">Insert via SQL</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
<div class="mt-3">
    <a href="{{ path('demo_home') }}" class="btn btn-outline-secondary">← Home</a>
</div>
{% endblock %}
