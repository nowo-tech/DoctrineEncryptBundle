{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Doctrine Encrypt Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Doctrine Encrypt Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Doctrine Encrypt Bundle">
            <a class="nowo-ui-link" href="{{ path('encrypt_util_demo') }}"{% if _route starts with 'encrypt_util' %} aria-current="page"{% endif %}>EncryptUtil &amp; Twig</a>
            <a class="nowo-ui-link" href="{{ path('secret_message_index') }}"{% if _route starts with 'secret_message' %} aria-current="page"{% endif %}>Secret messages</a>
            <a class="nowo-ui-link" href="{{ path('sensitive_record_index') }}"{% if _route starts with 'sensitive_record' %} aria-current="page"{% endif %}>Sensitive records</a>
            <a class="nowo-ui-link" href="{{ path('mysql_aes_note_index') }}"{% if _route starts with 'mysql_aes_note' %} aria-current="page"{% endif %}>MySQL AES</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_flashes %}
    {% for type, css in {success: 'success', error: 'error'} %}
        {% for message in app.flashes(type) %}
            <div class="nowo-ui-flash nowo-ui-flash--{{ css }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
