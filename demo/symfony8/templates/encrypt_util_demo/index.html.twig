{% extends 'base.html.twig' %}

{% block title %}EncryptUtil & Twig filters – Demo{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('demo_home') }}" class="btn btn-outline-secondary">← Back to home</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h2 class="mb-0">EncryptUtil + Twig filters</h2>
    </div>
    <div class="card-body">
        <p class="mb-0">This page uses <strong>EncryptUtil</strong> and Twig filter <code>|decrypt</code> with <strong>default</strong> config and with <strong>config indicada</strong> (<code>personal_data</code>, <code>financial_data</code>).</p>
    </div>
</div>

{# --- 1) EncryptUtil: default config --- #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h3 class="mb-0">1. EncryptUtil – default config</h3>
    </div>
    <div class="card-body">
        <p class="mb-2"><code>encrypt($plain)</code> / <code>decrypt($encrypted)</code> (no second argument)</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Plain</dt>
            <dd class="col-sm-9"><code>{{ plainDefault }}</code></dd>
            <dt class="col-sm-3">Encrypted</dt>
            <dd class="col-sm-9"><code class="text-break">{{ encryptedDefault }}</code></dd>
            <dt class="col-sm-3">Decrypted (round-trip)</dt>
            <dd class="col-sm-9"><code>{{ decryptedDefault }}</code></dd>
        </dl>
    </div>
</div>

{# --- 2) EncryptUtil: config personal_data --- #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h3 class="mb-0">2. EncryptUtil – config <code>personal_data</code></h3>
    </div>
    <div class="card-body">
        <p class="mb-2"><code>encrypt($plain, 'personal_data')</code> / <code>decrypt($encrypted, 'personal_data')</code></p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Plain</dt>
            <dd class="col-sm-9"><code>{{ plainPersonal }}</code></dd>
            <dt class="col-sm-3">Encrypted</dt>
            <dd class="col-sm-9"><code class="text-break">{{ encryptedPersonal }}</code></dd>
            <dt class="col-sm-3">Decrypted (round-trip)</dt>
            <dd class="col-sm-9"><code>{{ decryptedPersonal }}</code></dd>
        </dl>
    </div>
</div>

{# --- 3) EncryptUtil: config financial_data --- #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h3 class="mb-0">3. EncryptUtil – config <code>financial_data</code></h3>
    </div>
    <div class="card-body">
        <p class="mb-2"><code>encrypt($plain, 'financial_data')</code> / <code>decrypt($encrypted, 'financial_data')</code></p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Plain</dt>
            <dd class="col-sm-9"><code>{{ plainFinancial }}</code></dd>
            <dt class="col-sm-3">Encrypted</dt>
            <dd class="col-sm-9"><code class="text-break">{{ encryptedFinancial }}</code></dd>
            <dt class="col-sm-3">Decrypted (round-trip)</dt>
            <dd class="col-sm-9"><code>{{ decryptedFinancial }}</code></dd>
        </dl>
    </div>
</div>

{# --- 4) Twig filter: default and config indicada --- #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h3 class="mb-0">4. Twig filter <code>|decrypt</code> – default and config indicada</h3>
    </div>
    <div class="card-body">
        <p class="mb-2">Default: <code>{{ '{{ value|decrypt }}' }}</code> → <strong>{{ encryptedForTwigDefault|decrypt }}</strong></p>
        <p class="mb-2">Config indicada (misma que la default): <code>{{ '{{ value|decrypt(\'personal_data\') }}' }}</code> → <strong>{{ encryptedForTwigPersonal|decrypt('personal_data') }}</strong></p>
        <p class="mb-0">Config indicada distinta de la default: <code>{{ '{{ value|decrypt(\'financial_data\') }}' }}</code> → <strong>{{ encryptedForTwigFinancial|decrypt('financial_data') }}</strong></p>
    </div>
</div>
{% endblock %}
