{% extends 'base.html.twig' %}

{% block title %}MySQL AES – DB values{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Doctrine list</a>
        {% if nativeSupported %}
            <a href="{{ path('mysql_aes_note_sql_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">SQL list</a>
        {% endif %}
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Database values (encrypted vs decrypted)', intro: 'Loaded with raw SQL on mysql_aes_note. secret_orm = Doctrine + MysqlAes (with the ENC marker); secret_native = pure AES blob (HEX shown).', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Rows', kind: 'table', empty: rows|length == 0, state_message: 'No rows. Run make fixtures or create notes from the Doctrine / SQL forms.'} %}
        {% block section_actions %}
            <nav class="nowo-ui-row-actions" aria-label="Value mode">
                {% for key, label in {both: 'Both', raw: 'Encrypted only', decrypted: 'Decrypted only'} %}
                    <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline"{% if mode == key %} aria-current="page"{% endif %} href="{{ path('mysql_aes_note_db_values', { mode: key }) }}">{{ label }}</a>
                {% endfor %}
            </nav>
        {% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Title</th>
                        {% if mode in ['both', 'raw'] %}
                            <th scope="col"><code class="nowo-ui-code">secret_orm</code> (DB)</th>
                            <th scope="col"><code class="nowo-ui-code">secret_native</code> HEX (DB)</th>
                        {% endif %}
                        {% if mode in ['both', 'decrypted'] %}
                            <th scope="col"><code class="nowo-ui-code">secret_orm</code> decrypted</th>
                            <th scope="col"><code class="nowo-ui-code">secret_native</code> decrypted</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.id }}</td>
                            <td class="nowo-ui-cell--wrap">{{ row.title }}</td>
                            {% if mode in ['both', 'raw'] %}
                                <td class="nowo-ui-cell--wrap">
                                    {% if row.secret_orm_raw %}
                                        <code>{{ row.secret_orm_raw|slice(0, 120) }}{{ row.secret_orm_raw|length > 120 ? '…' : '' }}</code>
                                    {% else %}
                                        <span class="nowo-ui-muted">–</span>
                                    {% endif %}
                                </td>
                                <td class="nowo-ui-cell--wrap">
                                    {% if row.secret_native_hex %}
                                        <code>{{ row.secret_native_hex|slice(0, 64) }}{{ row.secret_native_hex|length > 64 ? '…' : '' }}</code>
                                    {% else %}
                                        <span class="nowo-ui-muted">–</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                            {% if mode in ['both', 'decrypted'] %}
                                <td class="nowo-ui-cell--wrap">{{ row.secret_orm_decrypted ?? '–' }}</td>
                                <td class="nowo-ui-cell--wrap">{{ row.secret_native_decrypted ?? '–' }}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
