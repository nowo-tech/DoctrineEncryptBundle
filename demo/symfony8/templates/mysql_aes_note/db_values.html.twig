{% extends 'base.html.twig' %}

{% block title %}MySQL AES – DB values{% endblock %}

{% block body %}
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h1>Database values (encrypted vs decrypted)</h1>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm">Doctrine list</a>
            {% if nativeSupported %}
                <a href="{{ path('mysql_aes_note_sql_index') }}" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm">SQL list</a>
            {% endif %}
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">
            Loaded with <strong>raw SQL</strong> on <code class="nowo-ui-code">mysql_aes_note</code>.
            <code class="nowo-ui-code">secret_orm</code> = Doctrine + MysqlAes (+ <code class="nowo-ui-code">&lt;ENC&gt;</code>);
            <code class="nowo-ui-code">secret_native</code> = pure AES blob (HEX shown).
        </p>

        <nav class="nowo-ui-row-actions" aria-label="Value mode">
            {% for key, label in {both: 'Both', raw: 'Encrypted only', decrypted: 'Decrypted only'} %}
                <a class="nowo-ui-btn nowo-ui-btn--sm {{ mode == key ? 'nowo-ui-btn--primary' : 'nowo-ui-btn--outline' }}"{% if mode == key %} aria-current="page"{% endif %} href="{{ path('mysql_aes_note_db_values', { mode: key }) }}">{{ label }}</a>
            {% endfor %}
        </nav>

        {% if rows|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Title</th>
                            {% if mode in ['both', 'raw'] %}
                                <th scope="col"><code class="nowo-ui-code">secret_orm</code> (DB)</th>
                                <th scope="col"><code class="nowo-ui-code">secret_native</code> HEX (DB)</th>
                            {% endif %}
                            {% if mode in ['both', 'decrypted'] %}
                                <th scope="col"><code class="nowo-ui-code">secret_orm</code> decrypted</th>
                                <th scope="col"><code class="nowo-ui-code">secret_native</code> decrypted</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.id }}</td>
                                <td>{{ row.title }}</td>
                                {% if mode in ['both', 'raw'] %}
                                    <td>
                                        {% if row.secret_orm_raw %}
                                            <code>{{ row.secret_orm_raw|slice(0, 120) }}{{ row.secret_orm_raw|length > 120 ? '…' : '' }}</code>
                                        {% else %}
                                            <span class="nowo-ui-muted">–</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if row.secret_native_hex %}
                                            <code>{{ row.secret_native_hex|slice(0, 64) }}{{ row.secret_native_hex|length > 64 ? '…' : '' }}</code>
                                        {% else %}
                                            <span class="nowo-ui-muted">–</span>
                                        {% endif %}
                                    </td>
                                {% endif %}
                                {% if mode in ['both', 'decrypted'] %}
                                    <td>{{ row.secret_orm_decrypted ?? '–' }}</td>
                                    <td>{{ row.secret_native_decrypted ?? '–' }}</td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No rows. Run <code class="nowo-ui-code">make fixtures</code> or create notes from the Doctrine / SQL forms.</p>
        {% endif %}
    </div>
</div>
<div>
    <a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back</a>
</div>
{% endblock %}
