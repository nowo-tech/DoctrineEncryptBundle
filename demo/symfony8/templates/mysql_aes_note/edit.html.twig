{% extends 'base.html.twig' %}

{% block title %}Edit MySQL AES note{% endblock %}

{% block body %}
<div>
    <a href="{{ path('mysql_aes_note_show', { id: note.id }) }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back</a>
</div>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2>Edit note #{{ note.id }}</h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form) }}
        <div>
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        </div>
        {% include 'mysql_aes_note/_form_actions.html.twig' with {
            submit_label: 'Update',
            cancel_path: path('mysql_aes_note_show', { id: note.id }),
        } %}
        {{ form_end(form) }}

        {{ form_start(delete_form) }}
            {% for child in delete_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
            <button type="submit" class="nowo-ui-btn nowo-ui-btn--danger">Delete</button>
        {{ form_end(delete_form) }}
    </div>
</div>
{% endblock %}
