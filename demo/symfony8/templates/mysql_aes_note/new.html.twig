{% extends 'base.html.twig' %}

{% block title %}New MySQL AES note (Doctrine){% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to list</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Create via Doctrine', intro: 'The secret is encrypted by the MysqlAes encryptor through the Doctrine subscriber.', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Note', kind: 'form', form: form, cancel_path: path('mysql_aes_note_index')} %}
        {% block section_body %}
            {{ form_start(form, { attr: { id: 'de-mysql-form' } }) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <a href="{{ cancel_path }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary" form="de-mysql-form">Save</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
