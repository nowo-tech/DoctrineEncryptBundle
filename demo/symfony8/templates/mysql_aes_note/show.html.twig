{% extends 'base.html.twig' %}

{% block title %}MySQL AES note #{{ note.id }}{% endblock %}

{% block body %}
<div><a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back</a></div>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <dt>Title</dt><dd>{{ note.title }}</dd>
            <dt>Secret (ORM)</dt><dd><pre class="nowo-ui-code-block">{{ note.secretOrm }}</pre></dd>
        </dl>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('mysql_aes_note_edit', { id: note.id }) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('mysql_aes_note_db_values') }}" class="nowo-ui-btn nowo-ui-btn--outline">View DB values</a>
        </div>
    </div>
</div>
{% endblock %}
