{% extends 'base.html.twig' %}

{% block title %}AES_DECRYPT list{% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="h4 mb-0">SQL: AES_DECRYPT list</h1>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('mysql_aes_note_sql_raw') }}" class="btn btn-outline-secondary btn-sm">Raw HEX</a>
            <a href="{{ path('mysql_aes_note_sql_new') }}" class="btn btn-primary btn-sm">New (AES_ENCRYPT)</a>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-4">Filter with MySQL <code>LIKE</code> on plain <code>title</code>, on <code>AES_DECRYPT(...)</code>, or on <code>HEX(secret_native)</code>.</p>

        <h2 class="h6 text-muted text-uppercase mb-3">Filter (LIKE)</h2>

        {% include 'mysql_aes_note/_list_filter.html.twig' with {
            filter: filter,
            clearPath: path('mysql_aes_note_sql_index'),
            secretModeOptions: {
                decrypted: 'LIKE on AES_DECRYPT (plaintext)',
                ciphertext: 'LIKE on HEX(blob) (ciphertext)',
            },
            queryDescription: queryDescription,
        } only %}

        {% if rows|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Title</th>
                            <th scope="col">Secret (decrypted)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.id }}</td>
                                <td>{{ row.title }}</td>
                                <td class="text-break">{{ row.secret_plain }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-5 border rounded bg-body-tertiary">
                <p class="text-muted mb-3">No native AES rows yet.</p>
                <a href="{{ path('mysql_aes_note_sql_new') }}" class="btn btn-primary">Insert via AES_ENCRYPT</a>
            </div>
        {% endif %}
    </div>
</div>
<div class="mt-3"><a href="{{ path('mysql_aes_note_index') }}" class="btn btn-outline-secondary">← Doctrine list</a></div>
{% endblock %}
