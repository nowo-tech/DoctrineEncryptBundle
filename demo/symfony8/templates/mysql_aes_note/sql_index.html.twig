{% extends 'base.html.twig' %}

{% block title %}AES_DECRYPT list{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Doctrine list</a>
        <a href="{{ path('mysql_aes_note_sql_raw') }}" class="nowo-ui-btn nowo-ui-btn--outline">Raw HEX</a>
        <a href="{{ path('mysql_aes_note_sql_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">New (AES_ENCRYPT)</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'SQL: AES_DECRYPT list', intro: 'Filter with MySQL LIKE on plain title, on AES_DECRYPT(...), or on HEX(secret_native).', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% include 'mysql_aes_note/_list_filter.html.twig' with {
        filter_form: filter_form,
        clearPath: path('mysql_aes_note_sql_index'),
        queryDescription: queryDescription,
    } only %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Notes', kind: 'table', empty: rows|length == 0, state_message: 'No native AES rows yet.'} %}
        {% block section_empty_action %}<a href="{{ path('mysql_aes_note_sql_new') }}" class="nowo-ui-btn nowo-ui-btn--outline">Insert via AES_ENCRYPT</a>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Title</th>
                        <th scope="col">Secret (decrypted)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.id }}</td>
                            <td class="nowo-ui-cell--wrap">{{ row.title }}</td>
                            <td class="nowo-ui-cell--wrap">{{ row.secret_plain }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
