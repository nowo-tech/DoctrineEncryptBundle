{% extends 'base.html.twig' %}

{% block title %}Insert with AES_ENCRYPT{% endblock %}

{% block body %}
<div>
    <a href="{{ path('mysql_aes_note_sql_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to SQL list</a>
</div>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2>Repository: INSERT … AES_ENCRYPT(:plain, :key)</h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form) }}
        <div>
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        </div>
        {% include 'mysql_aes_note/_form_actions.html.twig' with {
            submit_label: 'Insert via SQL',
            cancel_path: path('mysql_aes_note_sql_index'),
        } %}
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
