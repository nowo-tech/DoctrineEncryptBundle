{% extends 'base.html.twig' %}

{% block title %}Raw AES ciphertext{% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header"><h2 class="mb-0">HEX(secret_native) — as stored by MySQL</h2></div>
    <div class="card-body">
        <table class="table table-sm">
            <thead><tr><th>Id</th><th>Title</th><th>secret_native (hex)</th></tr></thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.id }}</td>
                        <td>{{ row.title }}</td>
                        <td><code class="small">{{ row.secret_native_hex }}</code></td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="text-muted">No rows.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3"><a href="{{ path('mysql_aes_note_sql_index') }}" class="btn btn-outline-secondary">← Decrypted list</a></div>
{% endblock %}
