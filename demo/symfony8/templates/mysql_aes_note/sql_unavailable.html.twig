{% extends 'base.html.twig' %}

{% block title %}MySQL required{% endblock %}

{% block body %}
<div class="nowo-ui-flash nowo-ui-flash--warning">
    <h2>Native AES_ENCRYPT / AES_DECRYPT</h2>
    <p>This demo needs <strong>MySQL or MariaDB</strong>. Copy the MySQL <code class="nowo-ui-code">DATABASE_URL</code> from <code class="nowo-ui-code">.env.example</code>, set <code class="nowo-ui-code">MYSQL_AES_KEY</code>, then run <code class="nowo-ui-code">make setup</code> in the demo.</p>
</div>
<a href="{{ path('mysql_aes_note_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back</a>
{% endblock %}
