{% extends 'base.html.twig' %}

{% block title %}Secret messages – DB values{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('secret_message_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Doctrine list</a>
        <a href="{{ path('secret_message_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create new</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Database values (encrypted vs decrypted)', intro: 'Loaded with raw SQL on secret_message. title is plain text; message is stored encrypted (Halite, config personal_data, includes the ENC marker).', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Rows', kind: 'table', empty: rows|length == 0, state_message: 'No rows. Run make fixtures or create a secret message.'} %}
        {% block section_actions %}
            <nav class="nowo-ui-row-actions" aria-label="Value mode">
                {% for key, label in {both: 'Both', raw: 'Encrypted only', decrypted: 'Decrypted only'} %}
                    <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline"{% if mode == key %} aria-current="page"{% endif %} href="{{ path('secret_message_db_values', { mode: key }) }}">{{ label }}</a>
                {% endfor %}
            </nav>
        {% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Title</th>
                        {% if mode in ['both', 'raw'] %}
                            <th scope="col"><code class="nowo-ui-code">message</code> (DB)</th>
                        {% endif %}
                        {% if mode in ['both', 'decrypted'] %}
                            <th scope="col"><code class="nowo-ui-code">message</code> decrypted</th>
                        {% endif %}
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.id }}</td>
                            <td class="nowo-ui-cell--wrap">{{ row.title ?? '–' }}</td>
                            {% if mode in ['both', 'raw'] %}
                                <td class="nowo-ui-cell--wrap">
                                    {% if row.message_raw %}
                                        <code>{{ row.message_raw|slice(0, 120) }}{{ row.message_raw|length > 120 ? '…' : '' }}</code>
                                    {% else %}
                                        <span class="nowo-ui-muted">–</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                            {% if mode in ['both', 'decrypted'] %}
                                <td class="nowo-ui-cell--wrap">{{ row.message_decrypted ?? '–' }}</td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('secret_message_show', { id: row.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('secret_message_edit', { id: row.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
