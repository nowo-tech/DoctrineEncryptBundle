{% extends 'base.html.twig' %}

{% block title %}Secret messages{% endblock %}

{% block body %}
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2>Secret messages</h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('secret_message_db_values') }}" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm">DB: raw vs decrypted</a>
            <a href="{{ path('secret_message_new') }}" class="nowo-ui-btn nowo-ui-btn--primary nowo-ui-btn--sm">Create new</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">
            <strong>message</strong> is encrypted in the database (Halite). <strong>title</strong> is plain text.
            Create or edit a message to see encryption in action; then check the MySQL database to see ciphertext.
        </p>
        {% if messages|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Title</th>
                            <th>Message (decrypted when loaded)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for msg in messages %}
                            <tr>
                                <td>{{ msg.id }}</td>
                                <td>{{ msg.title ?? '–' }}</td>
                                <td>{{ msg.message ? (msg.message|slice(0, 50)) ~ (msg.message|length > 50 ? '…' : '') : '–' }}</td>
                                <td>
                                    <a href="{{ path('secret_message_show', { id: msg.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('secret_message_edit', { id: msg.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = delete_forms[msg.id] %}
                                    {{ form_start(delete_form) }}
                                        {% for child in delete_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                                        <button type="submit" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--danger">Delete</button>
                                    {{ form_end(delete_form) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No secret messages yet. <a href="{{ path('secret_message_new') }}">Create the first one</a>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
