{% extends 'base.html.twig' %}

{% block title %}Secret messages{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('secret_message_db_values') }}" class="nowo-ui-btn nowo-ui-btn--outline">DB: raw vs decrypted</a>
        <a href="{{ path('secret_message_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create new</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Secret messages', intro: 'message is encrypted in the database (Halite); title is plain text. Create or edit a message to see encryption in action, then check the MySQL database to see ciphertext.', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Messages', kind: 'table', empty: messages|length == 0, state_message: 'No secret messages yet.'} %}
        {% block section_empty_action %}<a href="{{ path('secret_message_new') }}" class="nowo-ui-btn nowo-ui-btn--outline">Create the first one</a>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Title</th>
                        <th scope="col">Message (decrypted when loaded)</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for msg in messages %}
                        <tr>
                            <td>{{ msg.id }}</td>
                            <td class="nowo-ui-cell--wrap">{{ msg.title ?? '–' }}</td>
                            <td class="nowo-ui-cell--wrap">{{ msg.message ? (msg.message|slice(0, 50)) ~ (msg.message|length > 50 ? '…' : '') : '–' }}</td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('secret_message_show', { id: msg.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('secret_message_edit', { id: msg.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {{ include('_delete.html.twig', {form: delete_forms[msg.id], dialog_id: 'de-delete-secret-message-' ~ msg.id, title: 'Delete secret message #' ~ msg.id ~ '?', message: 'The message is removed from the database.', size: 'sm'}) }}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
