{% extends 'base.html.twig' %}

{% block title %}New secret message{% endblock %}

{% block body %}
<div>
    <a href="{{ path('secret_message_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to list</a>
</div>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2>Create secret message</h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form, { attr: { novalidate: true } }) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
        <hr>
        <div class="nowo-ui-row-actions">
            <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary">Create</button>
            <a href="{{ path('secret_message_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
