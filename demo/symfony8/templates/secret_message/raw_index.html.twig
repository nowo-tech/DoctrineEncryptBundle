{% extends 'base.html.twig' %}

{% block title %}Secret messages (raw SQL){% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Secret messages – Raw SQL</h2>
        <div class="d-flex gap-2">
            <a href="{{ path('secret_message_index') }}" class="btn btn-outline-light btn-sm">View with Doctrine (decrypted)</a>
            <a href="{{ path('secret_message_new') }}" class="btn btn-primary">Create new</a>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Data loaded with <strong>raw SQL</strong> (no Doctrine ORM). The <strong>message</strong> column shows the value as stored in the database (encrypted).
            Use Show / Edit / Delete to open the same Doctrine CRUD (decrypted).
        </p>
        {% if rows|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Title</th>
                            <th>Message (raw – encrypted in DB)</th>
                            <th>Actions (Doctrine)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.id }}</td>
                                <td>{{ row.title ?? '–' }}</td>
                                <td>
                                    <code class="small text-break">{{ row.message is not empty ? (row.message|slice(0, 80)) ~ (row.message|length > 80 ? '…' : '') : '–' }}</code>
                                </td>
                                <td>
                                    <a href="{{ path('secret_message_show', { id: row.id }) }}" class="btn btn-sm btn-outline-secondary">Show</a>
                                    <a href="{{ path('secret_message_edit', { id: row.id }) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form method="post" action="{{ path('secret_message_delete', { id: row.id }) }}" class="d-inline" onsubmit="return confirm('Delete this message?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ row.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-muted mb-0">No rows. <a href="{{ path('secret_message_new') }}">Create the first one</a> (via Doctrine).</p>
        {% endif %}
    </div>
</div>
{% endblock %}
