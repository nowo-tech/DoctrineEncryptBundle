{% extends 'base.html.twig' %}

{% block title %}Secret message #{{ secret_message.id }}{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('secret_message_index') }}" class="btn btn-outline-secondary">← Back to list</a>
</div>
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 class="mb-0 h5">Secret message #{{ secret_message.id }}</h2>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('secret_message_edit', { id: secret_message.id }) }}" class="btn btn-primary btn-sm">Edit</a>
            <a href="{{ path('secret_message_db_values') }}" class="btn btn-outline-secondary btn-sm">View DB values</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">{{ secret_message.id }}</dd>
            <dt class="col-sm-3">Title (plain)</dt>
            <dd class="col-sm-9">{{ secret_message.title ?? '–' }}</dd>
            <dt class="col-sm-3">Message (decrypted)</dt>
            <dd class="col-sm-9">{{ secret_message.message ?? '–' }}</dd>
        </dl>
        <form method="post" action="{{ path('secret_message_delete', { id: secret_message.id }) }}" class="mt-4 pt-3 border-top" onsubmit="return confirm('Delete this message?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ secret_message.id) }}">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>
{% endblock %}
