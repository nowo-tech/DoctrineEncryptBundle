{% extends 'base.html.twig' %}

{% block title %}Secret message #{{ secret_message.id }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('secret_message_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to list</a>
        <a href="{{ path('secret_message_db_values') }}" class="nowo-ui-btn nowo-ui-btn--outline">View DB values</a>
        <a href="{{ path('secret_message_edit', { id: secret_message.id }) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Secret message #' ~ secret_message.id, intro: 'The message is decrypted when loaded through Doctrine.', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}
            {{ include('_delete.html.twig', {form: delete_form, dialog_id: 'de-delete-secret-message', title: 'Delete secret message #' ~ secret_message.id ~ '?', message: 'The message is removed from the database.'}) }}
        {% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <dt>Id</dt>
                <dd>{{ secret_message.id }}</dd>
                <dt>Title (plain)</dt>
                <dd>{{ secret_message.title ?? '–' }}</dd>
                <dt>Message (decrypted)</dt>
                <dd>{{ secret_message.message ?? '–' }}</dd>
            </dl>
        {% endblock %}
    {% endembed %}
{% endblock %}
