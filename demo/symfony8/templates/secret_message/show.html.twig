{% extends 'base.html.twig' %}

{% block title %}Secret message #{{ secret_message.id }}{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('secret_message_index') }}" class="btn btn-outline-secondary">← Back to list</a>
</div>
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Secret message #{{ secret_message.id }}</h2>
        <div class="btn-group">
            <a href="{{ path('secret_message_edit', { id: secret_message.id }) }}" class="btn btn-primary">Edit</a>
            <a href="{{ path('secret_message_index') }}" class="btn btn-secondary">Back to list</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">{{ secret_message.id }}</dd>
            <dt class="col-sm-3">Title (plain)</dt>
            <dd class="col-sm-9">{{ secret_message.title ?? '–' }}</dd>
            <dt class="col-sm-3">Message (decrypted)</dt>
            <dd class="col-sm-9">{{ secret_message.message ?? '–' }}</dd>
        </dl>
        <form method="post" action="{{ path('secret_message_delete', { id: secret_message.id }) }}" class="d-inline" onsubmit="return confirm('Delete this message?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ secret_message.id) }}">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
</div>
{% endblock %}
