{% extends 'base.html.twig' %}

{% block title %}Sensitive records{% endblock %}

{% block body %}
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2>Sensitive records</h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('sensitive_record_raw_index') }}" class="nowo-ui-btn nowo-ui-btn--sm">View raw (SQL)</a>
            <a href="{{ path('sensitive_record_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create new</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">
            <strong>Personal note</strong> → encrypted with Halite (config <code class="nowo-ui-code">personal_data</code>). <strong>Financial note</strong> → encrypted with Defuse (config <code class="nowo-ui-code">financial_data</code>). Both decrypted when loaded via Doctrine.
        </p>
        {% if records|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Personal note (masked)</th>
                            <th>Financial note (masked)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rec in records %}
                            <tr>
                                <td>{{ rec.id }}</td>
                                <td>{{ rec.personalNote ? (rec.personalNote|mask(4)) : '–' }}</td>
                                <td>{{ rec.financialNote ? (rec.financialNote|mask(4)) : '–' }}</td>
                                <td>
                                    <a href="{{ path('sensitive_record_show', { id: rec.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('sensitive_record_edit', { id: rec.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = delete_forms[rec.id] %}
                                    {{ form_start(delete_form) }}
                                        {% for child in delete_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                                        <button type="submit" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--danger">Delete</button>
                                    {{ form_end(delete_form) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No sensitive records yet. <a href="{{ path('sensitive_record_new') }}">Create the first one</a> or load fixtures: <code class="nowo-ui-code">php bin/console doctrine:fixtures:load --group=sensitive_record</code>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
