{% extends 'base.html.twig' %}

{% block title %}Sensitive records{% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Sensitive records</h2>
        <div class="d-flex gap-2">
            <a href="{{ path('sensitive_record_raw_index') }}" class="btn btn-outline-light btn-sm">View raw (SQL)</a>
            <a href="{{ path('sensitive_record_new') }}" class="btn btn-primary">Create new</a>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            <strong>Personal note</strong> → encrypted with Halite (config <code>personal_data</code>). <strong>Financial note</strong> → encrypted with Defuse (config <code>financial_data</code>). Both decrypted when loaded via Doctrine.
        </p>
        {% if records|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Personal note (masked)</th>
                            <th>Financial note (masked)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rec in records %}
                            <tr>
                                <td>{{ rec.id }}</td>
                                <td>{{ rec.personalNote ? (rec.personalNote|mask(4)) : '–' }}</td>
                                <td>{{ rec.financialNote ? (rec.financialNote|mask(4)) : '–' }}</td>
                                <td>
                                    <a href="{{ path('sensitive_record_show', { id: rec.id }) }}" class="btn btn-sm btn-outline-secondary">Show</a>
                                    <a href="{{ path('sensitive_record_edit', { id: rec.id }) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form method="post" action="{{ path('sensitive_record_delete', { id: rec.id }) }}" class="d-inline" onsubmit="return confirm('Delete this record?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-muted mb-0">No sensitive records yet. <a href="{{ path('sensitive_record_new') }}">Create the first one</a> or load fixtures: <code>php bin/console doctrine:fixtures:load --group=sensitive_record</code>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
