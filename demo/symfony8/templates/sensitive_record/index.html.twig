{% extends 'base.html.twig' %}

{% block title %}Sensitive records{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('sensitive_record_raw_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">View raw (SQL)</a>
        <a href="{{ path('sensitive_record_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create new</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Sensitive records', intro: 'Personal note is encrypted with Halite (config personal_data); financial note with Defuse (config financial_data). Both are decrypted when loaded via Doctrine.', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Records', kind: 'table', empty: records|length == 0, state_message: 'No sensitive records yet. Create one or load fixtures: php bin/console doctrine:fixtures:load --group=sensitive_record.'} %}
        {% block section_empty_action %}<a href="{{ path('sensitive_record_new') }}" class="nowo-ui-btn nowo-ui-btn--outline">Create the first one</a>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Personal note (masked)</th>
                        <th scope="col">Financial note (masked)</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for rec in records %}
                        <tr>
                            <td>{{ rec.id }}</td>
                            <td class="nowo-ui-cell--wrap">{{ rec.personalNote ? (rec.personalNote|mask(4)) : '–' }}</td>
                            <td class="nowo-ui-cell--wrap">{{ rec.financialNote ? (rec.financialNote|mask(4)) : '–' }}</td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('sensitive_record_show', { id: rec.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('sensitive_record_edit', { id: rec.id }) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {{ include('_delete.html.twig', {form: delete_forms[rec.id], dialog_id: 'de-delete-sensitive-record-' ~ rec.id, title: 'Delete sensitive record #' ~ rec.id ~ '?', message: 'The record is removed from the database.', size: 'sm'}) }}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
