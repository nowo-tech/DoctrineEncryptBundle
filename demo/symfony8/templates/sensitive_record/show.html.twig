{% extends 'base.html.twig' %}

{% block title %}Sensitive record #{{ sensitive_record.id }}{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('sensitive_record_index') }}" class="btn btn-outline-secondary">← Back to list</a>
</div>
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Sensitive record #{{ sensitive_record.id }}</h2>
        <div class="btn-group">
            <a href="{{ path('sensitive_record_edit', { id: sensitive_record.id }) }}" class="btn btn-primary">Edit</a>
            <a href="{{ path('sensitive_record_index') }}" class="btn btn-secondary">Back to list</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">{{ sensitive_record.id }}</dd>
            <dt class="col-sm-3">Personal note (Halite)</dt>
            <dd class="col-sm-9">{{ sensitive_record.personalNote ?? '–' }}</dd>
            <dt class="col-sm-3">Financial note (Defuse)</dt>
            <dd class="col-sm-9">{{ sensitive_record.financialNote ?? '–' }}</dd>
        </dl>
        <form method="post" action="{{ path('sensitive_record_delete', { id: sensitive_record.id }) }}" class="d-inline" onsubmit="return confirm('Delete this record?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sensitive_record.id) }}">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
</div>
{% endblock %}
