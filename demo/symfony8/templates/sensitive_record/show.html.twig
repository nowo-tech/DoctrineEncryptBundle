{% extends 'base.html.twig' %}

{% block title %}Sensitive record #{{ sensitive_record.id }}{% endblock %}

{% block body %}
<div>
    <a href="{{ path('sensitive_record_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to list</a>
</div>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2>Sensitive record #{{ sensitive_record.id }}</h2>
        <div>
            <a href="{{ path('sensitive_record_edit', { id: sensitive_record.id }) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('sensitive_record_index') }}" class="nowo-ui-btn">Back to list</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <dt>Id</dt>
            <dd>{{ sensitive_record.id }}</dd>
            <dt>Personal note (Halite)</dt>
            <dd>{{ sensitive_record.personalNote ?? '–' }}</dd>
            <dt>Financial note (Defuse)</dt>
            <dd>{{ sensitive_record.financialNote ?? '–' }}</dd>
        </dl>
        {{ form_start(delete_form) }}
            {% for child in delete_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
            <button type="submit" class="nowo-ui-btn nowo-ui-btn--danger">Delete</button>
        {{ form_end(delete_form) }}
    </div>
</div>
{% endblock %}
