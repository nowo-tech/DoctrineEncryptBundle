{% extends 'base.html.twig' %}

{% block title %}Sensitive record #{{ sensitive_record.id }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('sensitive_record_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to list</a>
        <a href="{{ path('sensitive_record_edit', { id: sensitive_record.id }) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Sensitive record #' ~ sensitive_record.id, intro: 'Both notes are decrypted when loaded through Doctrine.', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}
            {{ include('_delete.html.twig', {form: delete_form, dialog_id: 'de-delete-sensitive-record', title: 'Delete sensitive record #' ~ sensitive_record.id ~ '?', message: 'The record is removed from the database.'}) }}
        {% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <dt>Id</dt>
                <dd>{{ sensitive_record.id }}</dd>
                <dt>Personal note (Halite)</dt>
                <dd>{{ sensitive_record.personalNote ?? '–' }}</dd>
                <dt>Financial note (Defuse)</dt>
                <dd>{{ sensitive_record.financialNote ?? '–' }}</dd>
            </dl>
        {% endblock %}
    {% endembed %}
{% endblock %}
