# PHPStan configuration for Doctrine Encrypt Bundle
# Compatible with PHP 8.1+ and Symfony 7.x / 8.x

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    ignoreErrors:
        - '#no value type specified in iterable type#'
