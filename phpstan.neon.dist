# PHPStan configuration for Doctrine Encrypt Bundle
# Level 8 (REQ-CS-006). PHP floor matches composer.json (>=8.2 <8.6).

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - tests/bootstrap.php
    bootstrapFiles:
        - phpstan/bootstrap.php
